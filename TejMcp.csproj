<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <Version>0.1.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <TejInstallRoot Condition="'$(TejInstallRoot)' == ''">C:\TejPro</TejInstallRoot>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="2.4.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.9" />
    <Reference Include="System.Security" />
    <Reference Include="TEJProClient">
      <HintPath>$(TejInstallRoot)\TEJ Smart Wizard\TEJProClient.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
